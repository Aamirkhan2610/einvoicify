# Paste these in Vercel → Project → Settings → Environment Variables

# SQLite only works locally. For Vercel demo use a free Neon Postgres URL, OR
# keep SQLite for static-ish demo (CRM writes may not persist on serverless):
DATABASE_URL="file:./dev.db"

# After deploy, set to your real Vercel URL:
NEXT_PUBLIC_SITE_URL="https://einvoicify.vercel.app"
NEXT_PUBLIC_PRODUCT_URL="https://app.einvoicify.my"

CRM_ADMIN_EMAIL="admin@einvoicify.my"
CRM_ADMIN_PASSWORD="einvoicify2026"
CRM_ADMIN_NAME="Einvoicify Admin"
CRM_AUTH_SECRET="change-this-to-a-long-random-string-for-demo"
